# Copy this file to .env, then replace the blank values.
# Generate a signing key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Redis is required for login-attempt protection.
REDIS_URL=redis://localhost:6379
LOGIN_RATE_LIMIT_PER_IDENTITY=5
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_CAPTCHA_IP_THRESHOLD=10
LOGIN_RATE_LIMIT_USERNAME_ALERT=5
LOGIN_RATE_LIMIT_GLOBAL_ALERT=500
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Generate a password hash with:
# python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('YOUR-STRONG-PASSWORD'))"
ADMIN_USERNAME=admin
ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
ADMIN_PASSWORD_HASH=

# Cloudflare Turnstile backend secret. Never expose this value in a browser.
TURNSTILE_SECRET_KEY=
# Optional: require Cloudflare's verified hostname to match this value.
TURNSTILE_EXPECTED_HOSTNAME=
