# Copy this file to .env, then replace the blank values.
# Generate a signing key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Redis is required for login-attempt protection.
REDIS_URL=redis://localhost:6379

# Keep false for direct/local access. Set true only after confirming that
# every request reaches the app through Cloudflare's trusted edge.
# In this mode, missing or invalid CF-Connecting-IP causes login to fail closed.
TRUST_CLOUDFLARE_CLIENT_IP=false

# Temporary staging-only visitor-IP diagnostic. Keep disabled except during
# an explicitly approved staging test. The token must be random and >=32 chars.
STAGING_DIAGNOSTICS_ENABLED=false
STAGING_DIAGNOSTICS_TOKEN=

LOGIN_CAPTCHA_IDENTITY_THRESHOLD=5
LOGIN_CAPTCHA_IP_THRESHOLD=20
LOGIN_CAPTCHA_VERIFIED_ATTEMPTS_PER_IP=30
LOGIN_CAPTCHA_VERIFIED_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT_USERNAME_ALERT=5
LOGIN_RATE_LIMIT_GLOBAL_ALERT=500
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Generate a password hash with:
# python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('YOUR-STRONG-PASSWORD'))"
ADMIN_USERNAME=admin
ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
ADMIN_PASSWORD_HASH=

# Cloudflare Turnstile backend secret. Never expose this value in a browser.
TURNSTILE_SECRET_KEY=
# Optional: require Cloudflare's verified hostname to match this value.
TURNSTILE_EXPECTED_HOSTNAME=
